<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="Compose_Previews">
  <template name="prevcomp" value="@Preview(showBackground = true)&#10;@Composable&#10;fun $COMPOSABLE_NAME$Preview() {&#10;    $COMPOSABLE_NAME$()&#10;    $END$&#10;}" description="Jetpack Compose Preview composable" toReformat="true" toShortenFQNames="true">
    <variable name="COMPOSABLE_NAME" expression="fileNameWithoutExtension().replaceAll(&quot;(?i)preview$&quot;, &quot;&quot;).trim()" defaultValue="MyComposable" alwaysStopAt="false" />
    <context>
      <option name="KOTLIN" value="true" />
    </context>
  </template>
</templateSet>

